{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "types": ["node"],

    "outDir": "./dist",
    "rootDir": ".",

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,

    "strict": true,
    "noImplicitAny": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "index.ts",
    "server.ts",
    "test-tasks.ts",
    "api/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "generated"]
}
